NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=.data/gitapp.sqlite

# One GitHub App: OAuth identifies the human, installations grant repository access.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Encrypts user-owned LLM/local-worker credentials at rest.
GITAPP_CREDENTIALS_KEY=

# Reserved for trusted service-to-service consumers such as VibeGuard/Hacka.
GITAPP_SERVICE_TOKEN=
